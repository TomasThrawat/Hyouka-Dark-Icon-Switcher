<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/subtitle"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="28dp" app:contentPadding="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<ImageView android:id="@+id/iconPreview" android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/ic_launcher_light" android:contentDescription="@string/icon_preview"/>
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/iconSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:text="@string/toggle_dark"/>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/geometry_note"/>
</LinearLayout>